# ============================================================
# ARA-1 Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.

# --- LLM Provider (choose one) ---
# Options: "groq", "openai", or "claude"
LLM_PROVIDER=groq

# --- Groq (FREE — recommended for getting started) ---
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (paid) ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# --- Anthropic (paid) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Agent Settings ---
MAX_ITERATIONS=10
LOG_LEVEL=INFO

# ============================================================
# Phase 2: Retrieval & Memory (optional)
# ============================================================

# Embedding API key (enables high-quality semantic retrieval)
# Without this, the system uses fallback embeddings (functional but lower quality)
# OPENAI_API_KEY=your-openai-api-key-here

# Vector store backend: "chroma" (local) or "pinecone" (production)
# VECTOR_BACKEND=chroma
# VECTOR_COLLECTION=ara_financial_docs

# Retrieval settings
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SIMILARITY=0.3

# Embedding model
# EMBEDDING_MODEL=text-embedding-3-small
